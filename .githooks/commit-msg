#!/usr/bin/env python3
"""commit-msg hook: strip AI attribution trailers and enforce the author identity.

Layer 2 of 3 (layer 1: .claude/settings.json attribution; layer 3: pre-push scan).
Set the allowed identity once:  git config hooks.allowedAuthorEmail "you@example.com"
"""
import re
import subprocess
import sys

STRIP = [
    r"^\s*co-authored-by:.*(claude|anthropic)",
    r"generated with \[?claude code",
    r"^\s*claude-session:",
    r"noreply@anthropic\.com",
]
FORBIDDEN_IDENT = re.compile(r"claude|anthropic", re.I)


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.strip()


def email_of(ident: str) -> str:
    m = re.search(r"<([^>]*)>", ident)
    return m.group(1).lower() if m else ""


path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    lines = f.read().splitlines()
kept = [l for l in lines if not any(re.search(p, l, re.I) for p in STRIP)]
while kept and not kept[-1].strip():
    kept.pop()
with open(path, "w", encoding="utf-8") as f:
    f.write("\n".join(kept) + "\n")

allowed = git("config", "--get", "hooks.allowedAuthorEmail").lower()
if not allowed:
    sys.exit("commit-msg: run  git config hooks.allowedAuthorEmail <your email>  first")
for var in ("GIT_AUTHOR_IDENT", "GIT_COMMITTER_IDENT"):
    ident = git("var", var)
    if email_of(ident) != allowed or FORBIDDEN_IDENT.search(ident):
        sys.exit(f"commit-msg: {var} is '{ident}', expected email {allowed}. Commit refused.")
