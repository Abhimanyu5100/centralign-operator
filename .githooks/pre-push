#!/usr/bin/env python3
"""pre-push hook: refuse to push commits with AI attribution or a foreign author (layer 3 of 3)."""
import subprocess
import sys

ZERO = "0" * 40
failed = False
for line in sys.stdin:
    _local_ref, local_sha, _remote_ref, remote_sha = line.split()
    if local_sha == ZERO:
        continue  # deleting a remote branch
    cmd = ["python3", "scripts/check_attribution.py"]
    if remote_sha != ZERO:
        cmd.append(f"{remote_sha}..{local_sha}")  # only the new commits
    # new branch: scan the whole history (stricter, still fast for a small repo)
    if subprocess.run(cmd).returncode != 0:
        failed = True
sys.exit(1 if failed else 0)
