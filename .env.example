# Copy to .env and fill in. Never commit .env.
# Model IDs: copy exact IDs from each provider console on Day 0 (free tiers change without notice).

# Google AI Studio (Gemini API, free tier) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=            # Flash model ID from AI Studio
GEMINI_LITE_MODEL=       # Flash-Lite model ID from AI Studio

# Groq (free plan) — https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# OpenRouter (emergency fallback, :free models) — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=   # a model ID ending in :free

# Runtime
REPLAY=0                 # 1 = serve LLM calls from cassettes only (no keys needed)
CASSETTE_DIR=cassettes
TZ_NAME=Asia/Kolkata
ACME_URL=http://localhost:8000
