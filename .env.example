# Copy to .env and fill in. Never commit .env.
# Keys stay in .env only. Model IDs below were checked by the author on 2026-10-09 (curl, outside the repo);
# free tiers change without notice, so re-check them in each console (docs/model-plan.md).
# Gate, planner and executor: Gemini Flash, then Flash-Lite. Groq serves only the judge and compaction.
# A provider with no key (or no base URL or model) is not configured and is skipped (D-165).

# Google AI Studio (Gemini API, free tier) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite   # the 2.5 models return 404 to new keys
GEMINI_FLASH2_MODEL=gemini-3.7-flash      # last in the executor chain (D-176, D-187; its own daily quota)
GEMINI_LITE2_MODEL=gemini-3.1-flash-lite  # second in the executor chain, after GEMINI_LITE_MODEL (D-187)

# Groq (free plan) — https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PLAN_MODEL=openai/gpt-oss-120b      # feasibility gate and planner (D-178), then the Gemini chain
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
GROQ_COMPACTION_MODEL=qwen/qwen3.8-27b      # compaction fallback (D-165; supersedes D-100's gpt-oss-20b)

# OpenRouter: optional, not used by this project (no key). Left empty it is skipped; a key added later just works.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=   # a model ID ending in :free

# Runtime
REPLAY=0                 # 1 = serve LLM calls from cassettes only (no keys needed)
CASSETTE_DIR=cassettes
LLM_TOKEN_BUDGET=300000   # per run: the LLM client stops the run past this many tokens
# Free-tier limits per model from AI Studio's rate-limit page (2026-10-09) and Groq's headers (model plan, D-179).
# LLM_DAILY_LIMITS: requests a day; the client skips a model at its limit. LLM_RPM: requests a minute; the client
# spaces calls to a model by 60/RPM seconds (optional; a model not listed is not spaced).
LLM_DAILY_LIMITS=gemini-3.5-flash-lite=500,gemini-3.1-flash-lite=500,gemini-3.5-flash=20,gemini-3.7-flash=20,openai/gpt-oss-120b=1000
LLM_RPM=gemini-3.5-flash-lite=15,gemini-3.1-flash-lite=15,gemini-3.5-flash=5,gemini-3.7-flash=5,openai/gpt-oss-120b=30
TZ_NAME=Asia/Kolkata
ACME_URL=http://localhost:8000
HEADED=0                 # 1 = show the agent's browser window (Day 2.3); default headless
ACME_HTTP_TIMEOUT_SECONDS=20   # the agent's HTTP client timeout (Day 2.2); keep well below ACME_CHAOS_TIMEOUT_DELAY_SECONDS
READ_LAG_SECONDS=6   # how long a read-back or a verifier check waits for a committed row to appear (D-123); above ACME_CHAOS_VISIBILITY_SECONDS

# Acme logins (sandbox). Unset = dev-only defaults from acme/auth.py. Never give the agent the admin password.
ACME_PASSWORD_OPS_AGENT=
ACME_PASSWORD_MEERA=
ACME_PASSWORD_ADMIN=
ACME_SESSION_TTL_SECONDS=28800   # 8 hours; only the chaos profile should expire sessions during a run
ACME_CHAOS_TIMEOUT_DELAY_SECONDS=120   # commit_then_timeout holds the response this long; keep the agent's HTTP timeout well below it
ACME_CHAOS_SLOW_SECONDS=1.5            # slow_server: each write is held 1x to 2x this (D-116)
ACME_CHAOS_TOAST_MS=2000               # toast_2s: transient messages disappear after this
ACME_CHAOS_VISIBILITY_SECONDS=5        # delayed_write: new rows stay hidden from the agent's reads this long

# Harness only: Acme's /__admin/* endpoints need this as the X-Admin-Token header. Unset or empty = admin routes closed.
# Never pass it to the agent, the code tool or the browser (the agent's tool environment must not contain it).
ACME_ADMIN_TOKEN=
