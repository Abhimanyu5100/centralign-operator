# Copy to .env and fill in. Never commit .env.
# Keys and model IDs are filled in during the Day 3 evening manual check (see SETUP.md).
# Model IDs: copy exact IDs from each provider console (free tiers change without notice).
# Groq is used only for the judge and compaction; gate, planner and executor fall back to
# Gemini Flash-Lite, then OpenRouter.

# Google AI Studio (Gemini API, free tier) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=            # Flash model ID: verify in console on Day 3
GEMINI_LITE_MODEL=       # Flash-Lite model ID: verify in console on Day 3

# Groq (free plan) — https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_JUDGE_MODEL=openai/gpt-oss-120b        # verify in console on Day 3
GROQ_COMPACTION_MODEL=openai/gpt-oss-20b    # compaction fallback; verify in console on Day 3

# OpenRouter (second fallback for gate, planner, executor; :free models) — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=   # a model ID ending in :free; verify in console on Day 3

# Runtime
REPLAY=0                 # 1 = serve LLM calls from cassettes only (no keys needed)
CASSETTE_DIR=cassettes
TZ_NAME=Asia/Kolkata
ACME_URL=http://localhost:8000
ACME_HTTP_TIMEOUT_SECONDS=20   # the agent's HTTP client timeout (Day 2.2); keep well below ACME_CHAOS_TIMEOUT_DELAY_SECONDS

# Acme logins (sandbox). Unset = dev-only defaults from acme/auth.py. Never give the agent the admin password.
ACME_PASSWORD_OPS_AGENT=
ACME_PASSWORD_MEERA=
ACME_PASSWORD_ADMIN=
ACME_SESSION_TTL_SECONDS=28800   # 8 hours; only the chaos profile should expire sessions during a run
ACME_CHAOS_TIMEOUT_DELAY_SECONDS=120   # commit_then_timeout holds the response this long; keep the agent's HTTP timeout well below it

# Harness only: Acme's /__admin/* endpoints need this as the X-Admin-Token header. Unset or empty = admin routes closed.
# Never pass it to the agent, the code tool or the browser (the agent's tool environment must not contain it).
ACME_ADMIN_TOKEN=
